# Copie este arquivo para .env e ajuste se necessário
MONGODB_URI=mongodb://localhost:27017/projeto-integrador
PORT=3000
# Libere apenas a origem do frontend autorizado
CORS_ORIGIN=http://localhost:4200
# Mantenha NODE_ENV=production no servidor publicado (oculta o Swagger)
NODE_ENV=development
# Segredo para assinatura do JWT (mínimo 32 caracteres, aula 12)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-pelo-menos-32-caracteres
